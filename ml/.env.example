# Copy to ml/.env and fill in. Required for the /admin page.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Raw insole pressure unit -> kPa multiplier (firmware logs 1.00 == 100 kPa)
PRESSURE_SCALE=100
# Store each dashboard prediction so it can be labelled later from /admin
LOG_PREDICTIONS=true
# Allowed browser origins if the ML API is called directly (the Next.js app proxies server-side)
CORS_ORIGINS=http://localhost:3000
